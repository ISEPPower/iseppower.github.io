---
import '../styles/global.css';
import { Font } from 'astro:assets';
import { SITE_TITLE } from '../consts';
import { sitePath } from '../utils/paths';
import { languageTag, type BlogLocale, type LanguageLink } from '../utils/blog';
interface Props { title: string; description: string; type?: 'website' | 'article'; locale?: BlogLocale; alternates?: LanguageLink[]; }
const { title, description, type = 'website', locale = 'en', alternates = [] } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const defaultLanguage = alternates.find(link => link.locale === 'en');
---
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<meta name="theme-color" content="#102b40" />
<link rel="icon" type="image/svg+xml" href={sitePath('favicon.svg')} />
<link rel="sitemap" href={sitePath('sitemap-index.xml')} />
<link rel="alternate" type="application/rss+xml" title={SITE_TITLE} href={sitePath(locale === 'pt' ? 'pt/rss.xml' : 'rss.xml')} />
<Font cssVariable="--font-atkinson" preload />
<link rel="canonical" href={canonicalURL} />
{alternates.map(link => <link rel="alternate" hreflang={languageTag[link.locale]} href={new URL(link.href, Astro.site)} />)}
{defaultLanguage && <link rel="alternate" hreflang="x-default" href={new URL(defaultLanguage.href, Astro.site)} />}
<title>{title}</title><meta name="description" content={description} />
<meta property="og:type" content={type} /><meta property="og:url" content={canonicalURL} />
<meta property="og:locale" content={locale === 'pt' ? 'pt_PT' : 'en_GB'} />
{alternates.filter(link => link.locale !== locale).map(link => <meta property="og:locale:alternate" content={link.locale === 'pt' ? 'pt_PT' : 'en_GB'} />)}
<meta property="og:site_name" content={SITE_TITLE} /><meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta name="twitter:card" content="summary" /><meta name="twitter:title" content={title} /><meta name="twitter:description" content={description} />
