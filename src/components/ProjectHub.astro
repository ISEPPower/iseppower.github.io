---
import SiteLayout from '../layouts/SiteLayout.astro';
import Hero from './Hero.astro';
import ProjectStatus from './ProjectStatus.astro';
import SystemConcept from './SystemConcept.astro';
import ChallengeTabs from './ChallengeTabs.astro';
import { REPOSITORY_URL } from '../consts';
import { localizedPath, type Locale } from '../utils/i18n';
interface Props { locale: Locale; }
const { locale } = Astro.props;
const pt = locale === 'pt';
const url = (path: string) => localizedPath(locale, path);
const sections = [
  ['overview', pt ? 'Questão do projeto' : 'Project question'],
  ['stages', pt ? 'Fases e estado' : 'Stages & status'],
  ['resources', pt ? 'Documentação e entregáveis' : 'Documents & deliverables'],
  ['team-notes', pt ? 'Contributos e especialistas' : 'Contributions & experts'],
];
---
<SiteLayout locale={locale} title={pt ? 'Desafios' : 'Challenges'} description={pt ? 'Os desafios de mestrado da ISEPower. Desafio ativo: Demand Response Advisor for Smart Grids.' : 'ISEPower’s master’s challenges. Active challenge: Demand Response Advisor for Smart Grids.'}>
<Hero eyebrow="ISEPower / MEIA" title={pt ? 'Os nossos desafios.' : 'Our challenges.'} description={pt ? 'Um espaço para acompanhar cada desafio do mestrado, as suas decisões e os seus resultados.' : 'A shared space to follow each master’s challenge, its decisions and its outcomes.'} />
<div class="container"><ChallengeTabs locale={locale}>
<div class="challenge-heading"><p class="eyebrow">{pt ? 'Desafio ativo / Desafio 1' : 'Active Challenge / Challenge 1'}</p><h2>Demand Response Advisor for Smart Grids</h2></div>
<div class="section editorial">
  <aside class="contents" aria-label={pt ? 'Nesta página' : 'On this page'}><p>{pt ? 'Nesta página' : 'On this page'}</p>{sections.map(([id, label]) => <a href={'#' + id}>{label}</a>)}</aside>
  <div>
    <section id="overview" class="document-section">
      <span class="badge">{pt ? 'Semana 1 · Em curso' : 'Week 1 · In progress'}</span>
      <h2>{sections[0][1]}</h2>
      <p>{pt ? 'Como pode um sistema recomendar uma alteração do consumo de eletricidade e explicar essa decisão, respeitando as necessidades do utilizador?' : 'How can a system recommend a change in electricity use and explain that decision while respecting the user’s needs?'}</p>
      <p>{pt ? 'Este projeto da Equipa 10, no MEIA do ISEP, está na fase inicial. Os utilizadores-alvo, cenários, fontes de conhecimento e método de avaliação ainda precisam de ser acordados.' : 'This Equipa 10 project, within MEIA at ISEP, is at its starting point. Target users, scenarios, knowledge sources and the evaluation method still need to be agreed.'}</p>
      <SystemConcept locale={locale} />
    </section>
    <section id="stages" class="document-section"><h2>{sections[1][1]}</h2><ProjectStatus locale={locale} /><a href={url('knowledge-engineering/')}>{pt ? 'Consultar as questões de engenharia do conhecimento' : 'Explore the knowledge engineering questions'} →</a></section>
    <section id="resources" class="document-section">
      <h2>{sections[2][1]}</h2>
      <p>{pt ? 'Materiais disponíveis agora. As apresentações, o relatório técnico e o vídeo de demonstração serão acrescentados quando estiverem prontos.' : 'Materials available now. Presentations, the technical report and a demonstration video will be added when they are ready.'}</p>
      <ul class="resource-list">
        <li><a href={url('blog/project-kickoff/')}>{pt ? 'Relatório da semana 1' : 'Week 1 report'} →</a><span>{pt ? 'Relatório em curso · Português' : 'Ongoing report · English'}</span></li>
        <li><a href={url('knowledge-engineering/')}>{pt ? 'Mapa conceptual e questões em aberto' : 'Concept map & open questions'} →</a><span>{pt ? 'Documento vivo · Português' : 'Living document · English'}</span></li>
        <li><a href={REPOSITORY_URL}>{pt ? 'Código-fonte do site' : 'Website source code'} ↗</a><span>GitHub · English / Português</span></li>
      </ul>
      <p class="caption">{pt ? 'Ainda não foram publicados resultados de avaliação nem poupanças medidas.' : 'No evaluation results or measured savings have been published yet.'}</p>
    </section>
    <section id="team-notes" class="document-section">
      <h2>{sections[3][1]}</h2>
      <p>{pt ? 'Cada relatório pode identificar os autores e os contributos individuais. A distribuição de tarefas da semana 1 ainda não está registada.' : 'Each report can identify its authors and individual contributions. The week 1 task allocation has not yet been recorded.'}</p>
      <p>{pt ? 'Ainda não existem notas de reuniões com especialistas publicadas. Quando houver uma sessão, o registo incluirá a pergunta, o que aprendemos e a decisão alterada, com data e participantes.' : 'No expert meeting notes have been published yet. When a session takes place, its record will include the question, what we learned and the decision it changed, with the date and participants.'}</p>
      <a href={url('team/')}>{pt ? 'Conhecer a equipa' : 'Meet the team'} →</a>
    </section>
  </div>
</div>
</ChallengeTabs></div>
</SiteLayout>
<style>
  .challenge-heading { padding-top: 3rem; max-width: 850px; }
  .document-section > .badge { margin-bottom: 1rem; }
  .resource-list { list-style: none; padding: 0; }
  .resource-list li { padding: 1rem 0; border-bottom: 1px solid var(--line); }
  .resource-list a { font-weight: 700; }
  .resource-list span { display: block; margin-top: .3rem; font-size: .8rem; color: var(--muted); }
</style>
