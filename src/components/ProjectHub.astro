---
import SiteLayout from '../layouts/SiteLayout.astro';
import Hero from './Hero.astro';
import ProjectStatus from './ProjectStatus.astro';
import SystemConcept from './SystemConcept.astro';
import ChallengeTabs from './ChallengeTabs.astro';
import PostVideo from './PostVideo.astro';
import { REPOSITORY_URL, LIVE_APP_URL } from '../consts';
import { team } from '../data/team';
const challenge2Team = team.filter(member => member.challenges.includes(2));
const newMembers = challenge2Team.filter(member => !member.challenges.includes(1));
const names = (members: typeof team) => new Intl.ListFormat(pt ? 'pt-PT' : 'en', { type: 'conjunction' }).format(members.map(member => member.name));
import { localizedPath, type Locale } from '../utils/i18n';
interface Props { locale: Locale; }
const { locale } = Astro.props;
const pt = locale === 'pt';
const url = (path: string) => localizedPath(locale, path);
const sections = [
  ['overview', pt ? 'Questão do projeto' : 'Project question'],
  ['stages', pt ? 'Fases e estado' : 'Stages & status'],
  ['resources', pt ? 'Documentação e entregáveis' : 'Documents & deliverables'],
  ['team-notes', pt ? 'Contributos e especialistas' : 'Contributions & experts'],
];
---
<SiteLayout locale={locale} title={pt ? 'Desafios' : 'Challenges'} description={pt ? 'Os desafios de mestrado da ISEPower. Desafio 1 concluído: Demand Response Advisor for Smart Grids. Desafio 2 em preparação.' : 'ISEPower’s master’s challenges. Challenge 1 completed: Demand Response Advisor for Smart Grids. Challenge 2 is getting started.'}>
<Hero eyebrow="ISEPower / MEIA" title={pt ? 'Os nossos desafios.' : 'Our challenges.'} description={pt ? 'Um espaço para acompanhar cada desafio do mestrado, as suas decisões e os seus resultados.' : 'A shared space to follow each master’s challenge, its decisions and its outcomes.'} />
<div class="container"><ChallengeTabs locale={locale}>
<div slot="challenge-2">
  <div class="challenge-heading"><p class="eyebrow">{pt ? 'Desafio ativo / Desafio 2' : 'Active Challenge / Challenge 2'}</p><h2>{pt ? 'Tema em escolha' : 'Topic to be chosen'}</h2></div>
  <div class="section editorial">
    <div></div>
    <div>
      <section id="challenge-2-overview" class="document-section">
        <span class="badge">{pt ? 'Semana 1 · Escolha do tema' : 'Week 1 · Topic selection'}</span>
        <h2>{pt ? 'Um novo desafio, uma equipa maior' : 'A new challenge, a larger team'}</h2>
        <p>{pt ? 'Depois de entregar o Desafio 1, a equipa está a analisar os temas propostos para o Desafio 2. O tema escolhido, a questão do projeto e as fases serão publicados aqui e no blog.' : 'After delivering Challenge 1, the team is reviewing the topics proposed for Challenge 2. The chosen topic, the project question and the stages will be published here and in the blog.'}</p>
        <p>{pt ? `${names(newMembers)} juntam-se à equipa neste desafio. O Vitor Gonçalo Jesus participou no Desafio 1.` : `${names(newMembers)} join the team for this challenge. Vitor Gonçalo Jesus took part in Challenge 1.`}</p>
        <p>{pt ? 'Equipa do Desafio 2' : 'Challenge 2 team'}: {names(challenge2Team)}.</p>
        <a href={url('team/')}>{pt ? 'Conhecer a equipa' : 'Meet the team'} →</a>
      </section>
    </div>
  </div>
</div>
<div slot="challenge-1">
<div class="challenge-heading"><p class="eyebrow">{pt ? 'Desafio concluído / Desafio 1' : 'Completed Challenge / Challenge 1'}</p><h2>Demand Response Advisor for Smart Grids</h2></div>
<div class="challenge-film"><PostVideo src="videos/week-6/final-demo.mp4" title={pt ? 'Demand Response Advisor: o filme final' : 'Demand Response Advisor: the final film'} caption={pt ? 'O filme final do Desafio 1.' : 'The final film of Challenge 1.'} /></div>
<div class="section editorial">
  <aside class="contents" aria-label={pt ? 'Nesta página' : 'On this page'}><p>{pt ? 'Nesta página' : 'On this page'}</p>{sections.map(([id, label]) => <a href={'#' + id}>{label}</a>)}</aside>
  <div>
    <section id="overview" class="document-section">
      <span class="badge">{pt ? 'Semana 6 · Concluído' : 'Week 6 · Complete'}</span>
      <h2>{sections[0][1]}</h2>
      <p>{pt ? 'Como pode um sistema recomendar uma alteração do consumo de eletricidade e explicar essa decisão, respeitando as necessidades do utilizador?' : 'How can a system recommend a change in electricity use and explain that decision while respecting the user’s needs?'}</p>
      <p>{pt ? 'Este projeto da Equipa 10, no MEIA do ISEP, tem uma base de conhecimento em dois níveis, incluindo o evento de Demand Response, que funciona em Prolog e em Drools e explica cada decisão. O sistema está online, foi revisto pelo especialista em duas sessões e foi entregue a 25 de outubro com dois relatórios finais.' : 'This Equipa 10 project, within MEIA at ISEP, has a two-level knowledge base, including the Demand Response event, that runs in Prolog and Drools and explains each decision. The advisor is live, was reviewed by the expert in two sessions and was delivered on 25 October with two final reports.'}</p>
      <p><a class="button" href={LIVE_APP_URL}>{pt ? 'Abrir a aplicação online' : 'Open the live app'} ↗</a></p>
      <SystemConcept locale={locale} />
    </section>
    <section id="stages" class="document-section"><h2>{sections[1][1]}</h2><ProjectStatus locale={locale} /><a href={url('knowledge-engineering/')}>{pt ? 'Consultar as questões de engenharia do conhecimento' : 'Explore the knowledge engineering questions'} →</a></section>
    <section id="resources" class="document-section">
      <h2>{sections[2][1]}</h2>
      <p>{pt ? 'Materiais disponíveis. O filme final está no topo desta página e no relatório da semana 6.' : 'Available materials. The final film is at the top of this page and in the week 6 report.'}</p>
      <ul class="resource-list">
        <li><a href={LIVE_APP_URL}>{pt ? 'Aplicação online: Demand Response Advisor' : 'Live app: Demand Response Advisor'} ↗</a><span>{pt ? 'Servidor do DEI · Inglês' : 'DEI server · English'}</span></li>
        <li><a href={url('blog/week-6-challenge-delivered/')}>{pt ? 'Relatório da semana 6' : 'Week 6 report'} →</a><span>{pt ? 'Desafio entregue: resultados, contexto real e filme final · Português' : 'Challenge delivered: results, real-world context and final film · English'}</span></li>
        <li><a href={url('blog/week-5-deployment-expert-session/')}>{pt ? 'Relatório da semana 5' : 'Week 5 report'} →</a><span>{pt ? 'Instalação, intervalos de datas e segunda sessão com o especialista · Português' : 'Deployment, date ranges and second expert session · English'}</span></li>
        <li><a href={url('blog/week-4-rule-engine-prototype/')}>{pt ? 'Relatório da semana 4' : 'Week 4 report'} →</a><span>{pt ? 'Motor de regras, explicações, cenários de teste e vídeos · Português' : 'Rule engine, explanations, test scenarios and videos · English'}</span></li>
        <li><a href={url('blog/week-3-first-prototype/')}>{pt ? 'Relatório da semana 3' : 'Week 3 report'} →</a><span>{pt ? 'Revisão do especialista e primeiro protótipo · Português' : 'Expert review and first prototype · English'}</span></li>
        <li><a href={url('blog/week-2-expert-selection/')}>{pt ? 'Relatório da semana 2' : 'Week 2 report'} →</a><span>{pt ? 'Aquisição de conhecimento em curso · Português' : 'Knowledge acquisition in progress · English'}</span></li>
        <li><a href={url('challenges/1/expert/')}>{pt ? 'Especialista do Desafio 1' : 'Challenge 1 expert'}: João André Pinto Soares →</a></li>
        <li><a href={url('blog/project-kickoff/')}>{pt ? 'Relatório da semana 1' : 'Week 1 report'} →</a><span>{pt ? 'Relatório em curso · Português' : 'Ongoing report · English'}</span></li>
        <li><a href={url('knowledge-engineering/')}>{pt ? 'Mapa conceptual e questões em aberto' : 'Concept map & open questions'} →</a><span>{pt ? 'Documento vivo · Português' : 'Living document · English'}</span></li>
        <li><a href={REPOSITORY_URL}>{pt ? 'Código-fonte do site' : 'Website source code'} ↗</a><span>GitHub · English / Português</span></li>
      </ul>
      <p class="caption">{pt ? 'Os resultados publicados são simulados para uma habitação. Não foram publicadas poupanças medidas.' : 'The published results are simulated for one household. No measured savings have been published.'}</p>
    </section>
    <section id="team-notes" class="document-section">
      <h2>{sections[3][1]}</h2>
      <p>{pt ? 'João André Pinto Soares é o especialista do Desafio 1. Na semana 3, reviu a base de conhecimento e as regras de decisão; na semana 5, reviu o sistema instalado.' : 'João André Pinto Soares is the expert for Challenge 1. In week 3 he reviewed the knowledge base and decision rules; in week 5 he reviewed the deployed advisor.'}</p>
      <a href={url('challenges/1/expert/')}>{pt ? 'Conhecer o especialista do Desafio 1' : 'Meet the Challenge 1 expert'} →</a>
      <p>{pt ? 'Cada relatório pode identificar os autores e os contributos individuais. A distribuição de tarefas da semana 1 ainda não está registada.' : 'Each report can identify its authors and individual contributions. The week 1 task allocation has not yet been recorded.'}</p>
      <p>{pt ? 'O resumo da primeira sessão com o especialista está no relatório da semana 3, e o da segunda sessão (15 de outubro) está no relatório da semana 5.' : 'The summary of the first expert session is in the week 3 report, and the second session (15 October) is summarised in the week 5 report.'}</p>
      <a href={url('team/')}>{pt ? 'Conhecer a equipa' : 'Meet the team'} →</a>
    </section>
  </div>
</div>
</div>
</ChallengeTabs></div>
</SiteLayout>
<style>
  .challenge-heading { padding-top: 3rem; max-width: 850px; }
  .challenge-film { max-width: 960px; padding-top: 1.5rem; }
  .challenge-film :global(.post-video) { margin-bottom: 0; }
  .document-section > .badge { margin-bottom: 1rem; }
  .resource-list { list-style: none; padding: 0; }
  .resource-list li { padding: 1rem 0; border-bottom: 1px solid var(--line); }
  .resource-list a { font-weight: 700; }
  .resource-list span { display: block; margin-top: .3rem; font-size: .8rem; color: var(--muted); }
</style>
