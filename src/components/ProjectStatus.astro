---
import { projectCopy } from '../data/project';
import { localizedPath, type Locale } from '../utils/i18n';
interface Props { locale?: Locale; }
const { locale = 'en' } = Astro.props;
const t = projectCopy[locale];
---
<p>{t.stageIntro}</p>
<ol class="project-stages">
  {t.stages.map(([title, description], index) => <li aria-current={index === 1 ? 'step' : undefined}>
    <span class="stage-number" aria-hidden="true">0{index + 1}</span>
    <div><span class:list={['badge', { future: index !== 1 }]}>{index === 1 ? `${t.week} · ${t.active}` : index === 0 ? t.open : t.planned}</span><h3>{title}</h3><p>{description}</p>
    {index === 1 && <a href={localizedPath(locale, 'blog/week-2-expert-selection/')}>{t.read} →</a>}</div>
  </li>)}
</ol>
<style>
  .project-stages { list-style: none; padding: 0; margin: 2rem 0; }
  li { display: grid; grid-template-columns: 2.5rem 1fr; gap: 1rem; padding: 1.5rem 0; border-bottom: 1px solid var(--line); }
  .stage-number { font-size: .9rem; color: var(--muted); padding-top: .15rem; }
  li[aria-current] .stage-number { color: var(--blue); font-weight: 700; }
  h3 { margin: .8rem 0 .5rem; }
  p { color: var(--muted); margin-bottom: .6rem; }
  .future { background: var(--surface); color: var(--muted); }
</style>
