---
import SiteLayout from '../layouts/SiteLayout.astro';
import Hero from './Hero.astro';
import SystemConcept from './SystemConcept.astro';
import { localizedPath, type Locale } from '../utils/i18n';
interface Props { locale: Locale; }
const { locale } = Astro.props;
const pt = locale === 'pt';
const questions = pt ? [
  ['Problema', 'Quem irá utilizar o sistema e que tarefa poderá alterar? Que prazos e necessidades devem ser respeitados?'],
  ['Conhecimento', 'Que fontes sustentam cada conceito? Que informação falta e deve ser validada com um especialista?'],
  ['Representação e raciocínio', 'Como representar restrições e justificar uma recomendação? As regras estão organizadas em dois níveis (avaliação e decisão), implementadas em Prolog e em Drools, e cada decisão é acompanhada de uma explicação e de um «porque não».'],
  ['Avaliação', 'Que cenários permitirão verificar se as recomendações respeitam as restrições? Oito cenários de referência verificam as decisões e existe um primeiro resultado simulado; os cenários de avaliação ainda não estão acordados.'],
] : [
  ['Problem', 'Who will use the system, and which task could they change? What deadlines and needs must be respected?'],
  ['Knowledge', 'Which sources support each concept? What information is missing and should be validated with an expert?'],
  ['Representation & reasoning', 'How should constraints be represented and a recommendation justified? Rules are organised in two levels (assessment and decision), implemented in both Prolog and Drools, and every decision comes with an explanation and a “why not”.'],
  ['Evaluation', 'Which scenarios will check whether recommendations respect constraints? Eight reference scenarios check the decisions and there is a first simulated result; the evaluation scenarios are not yet agreed.'],
];
---
<SiteLayout locale={locale} title={pt ? 'Engenharia do Conhecimento' : 'Knowledge Engineering'}>
  <Hero eyebrow={pt ? 'Desafio 1 / Semana 4' : 'Challenge 1 / Week 4'} title={pt ? 'Base de conhecimento executável.' : 'An executable knowledge base.'} description={pt ? 'Doze regras de avaliação e nove regras de decisão, incluindo o evento de Demand Response da rede, funcionam em Prolog e em Drools e explicam cada decisão START_NOW / DEFER.' : 'Twelve assessment rules and nine decision rules, including the grid’s Demand Response event, run in Prolog and Drools and explain each START_NOW / DEFER decision.'} />
  <div class="container"><a href={localizedPath(locale, 'challenges/1/expert/')}>{pt ? 'Conhecer o especialista do Desafio 1' : 'Meet the Challenge 1 expert'} →</a></div>
  <section class="section container"><SystemConcept locale={locale} /><div class="grid-2">{questions.map(([title, description]) => <article class="feature-card"><h2>{title}</h2><p>{description}</p></article>)}</div>
  <div class="callout"><h2>{pt ? 'Registo de fontes' : 'Source record'}</h2><p>{pt ? 'Ainda não foi publicada uma lista de fontes técnicas. Cada entrada deverá indicar a referência, o conceito sustentado e as limitações identificadas.' : 'A technical source list has not yet been published. Each entry should identify the reference, the concept it supports and any limitations.'}</p></div>
  </section>
</SiteLayout>
<style>h2 { font-size: 1.4rem; }</style>
