---
import { sitePath } from '../utils/paths';
interface Props { src: string; title: string; caption?: string; }
// src is a path relative to public/, e.g. videos/week-4/week-4-full.mp4
const { src, title, caption } = Astro.props;
---
<figure class="post-video">
  <video controls preload="metadata" playsinline aria-label={title}>
    <source src={sitePath(src)} type="video/mp4" />
    <a href={sitePath(src)}>{title}</a>
  </video>
  {caption && <figcaption class="caption">{caption}</figcaption>}
</figure>
<style>
  .post-video { margin: 0 0 2.5rem; }
  video { display: block; width: 100%; height: auto; border-radius: var(--radius); background: #000; }
  .caption { margin-top: .6rem; }
</style>
