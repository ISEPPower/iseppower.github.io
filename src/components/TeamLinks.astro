---
import type { TeamMember } from '../data/team';
import type { Locale } from '../utils/i18n';
interface Props { member: TeamMember; locale?: Locale; }
const { member, locale = 'en' } = Astro.props;
const pt = locale === 'pt';
const linkedInLabel = pt ? member.name + ' no LinkedIn' : member.name + ' on LinkedIn';
const emailLabel = pt ? 'Enviar email a ' + member.name : 'Email ' + member.name;
---
<div class="team-links">
  {member.linkedin && <a class="contact-icon" href={member.linkedin} aria-label={linkedInLabel} title={linkedInLabel}>
    <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false"><path d="M20.45 2H3.55C2.69 2 2 2.68 2 3.52v16.96c0 .84.69 1.52 1.55 1.52h16.9c.86 0 1.55-.68 1.55-1.52V3.52c0-.84-.69-1.52-1.55-1.52ZM7.93 18.75H4.98V9.2h2.95v9.55ZM6.46 7.9a1.71 1.71 0 1 1 0-3.42 1.71 1.71 0 0 1 0 3.42Zm12.29 10.85H15.8V14.1c0-1.11-.02-2.54-1.55-2.54-1.55 0-1.79 1.21-1.79 2.46v4.73H9.51V9.2h2.83v1.3h.04c.39-.74 1.36-1.53 2.8-1.53 2.99 0 3.57 1.97 3.57 4.53v5.25Z" /></svg>
  </a>}
  {member.github && <a href={member.github} aria-label={member.name + (pt ? ' no GitHub' : ' on GitHub')}>GitHub ↗</a>}
  {member.email && <a class="contact-icon" href={'mailto:' + member.email} aria-label={emailLabel + ': ' + member.email} title={member.email}>
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect x="3" y="5" width="18" height="14" rx="2" /><path d="m3 7 9 6 9-6" /></svg>
  </a>}
  {!member.linkedin && !member.github && !member.email && <span>{pt ? 'Ligações de perfil a adicionar' : 'Profile links to be added'}</span>}
</div>
<style>
  .contact-icon { display: inline-flex; align-items: center; justify-content: center; width: 44px; height: 44px; border: 1px solid var(--line); border-radius: 8px; background: var(--surface); color: var(--blue); text-decoration: none; }
  .contact-icon:hover { background: var(--blue); border-color: var(--blue); color: white; }
  .team-links { align-items: center; gap: .65rem; }
</style>
