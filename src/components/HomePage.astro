---
import SiteLayout from '../layouts/SiteLayout.astro';
import HomeLoader from './HomeLoader.astro';
import HomeMotion from './HomeMotion.astro';
import WeekOverview from './WeekOverview.astro';
import PostCard from './PostCard.astro';
import { getBlogPosts } from '../utils/blog';
import { localizedPath, type Locale } from '../utils/i18n';
import { PROJECT_TITLE } from '../consts';
interface Props { locale: Locale; }
const { locale } = Astro.props;
const pt = locale === 'pt';
const path = (value: string) => localizedPath(locale, value);
const posts = (await getBlogPosts()).filter(post => post.data.lang === locale).slice(0, 3);
---
<SiteLayout locale={locale} description={pt ? 'ISEPower: os desafios, a equipa e o diário de desenvolvimento do MEIA no ISEP.' : 'ISEPower: master’s challenges, the team and our development journal at ISEP.'}>
  <HomeLoader slot="loader" locale={locale} />
  <HomeMotion>
    <section class="home-hero"><div class="container">
      <div class="hero-grid">
        <div><p class="eyebrow">Equipa 10 / MEIA / ISEP</p><h1>ISEPower<br /><span>{pt ? 'Aprender. Construir. Partilhar.' : 'Learn. Build. Share.'}</span></h1><p class="lead">{pt ? 'Acompanhe os nossos desafios de mestrado em inteligência artificial: das primeiras perguntas às decisões e aos resultados.' : 'Follow our artificial intelligence master’s challenges, from opening questions to decisions and outcomes.'}</p>
        <div class="actions"><a class="button" href={path('challenges/')}>{pt ? 'Explorar os desafios' : 'Explore the challenges'} ↗</a><a class="button secondary" href={path('blog/')}>{pt ? 'Ler o diário' : 'Read the journal'} →</a></div></div>
        <article class="active-challenge"><p class="eyebrow">{pt ? 'Desafio ativo / Desafio 1' : 'Active Challenge / Challenge 1'}</p><h2>{PROJECT_TITLE}</h2><p>{pt ? 'Um sistema de aconselhamento para apoiar decisões de resposta da procura em redes elétricas inteligentes.' : 'An advisory system to support demand response decisions in smart grids.'}</p><a href={path('challenges/#challenge-1')}>{pt ? 'Abrir o Desafio 1' : 'Open Challenge 1'} →</a><p class="upcoming">{pt ? 'Desafios 2–4 · Em breve' : 'Challenges 2–4 · Coming soon'}</p></article>
      </div>
    </div></section>
    <WeekOverview locale={locale} />
    <section class="section soft"><div class="container"><div class="section-heading-row"><div class="section-title"><p class="eyebrow">ISEPower / {pt ? 'Diário' : 'Journal'}</p><h2>{pt ? 'Últimas publicações' : 'Latest posts'}</h2></div><a class="text-link" href={path('blog/')}>{pt ? 'Todas as publicações' : 'All posts'} →</a></div><div class="post-list">{posts.map(post => <PostCard post={post} />)}</div></div></section>
  </HomeMotion>
</SiteLayout>
<style>
  .active-challenge { padding: 2rem; border: 1px solid #38576c; border-radius: var(--radius); background: #15344b; }
  .active-challenge h2 { color: white; font-size: clamp(1.6rem, 3vw, 2.2rem); }
  .active-challenge p { color: #c8d8e2; }
  .active-challenge a { color: var(--green); font-weight: 700; }
  .active-challenge .upcoming { font-size: .8rem; border-top: 1px solid #38576c; padding-top: 1rem; margin: 1.5rem 0 0; }
</style>
