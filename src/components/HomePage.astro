---
import SiteLayout from '../layouts/SiteLayout.astro';
import HomeLoader from './HomeLoader.astro';
import HomeMotion from './HomeMotion.astro';
import WeekOverview from './WeekOverview.astro';
import PostCard from './PostCard.astro';
import GridConcept from './GridConcept.astro';
import { getBlogPosts } from '../utils/blog';
import { localizedPath, type Locale } from '../utils/i18n';
import { projectCopy } from '../data/project';
interface Props { locale: Locale; }
const { locale } = Astro.props;
const pt = locale === 'pt';
const status = projectCopy[locale];
const path = (value: string) => localizedPath(locale, value);
const posts = (await getBlogPosts()).filter(post => post.data.lang === locale).slice(0, 3);
---
<SiteLayout locale={locale} description={pt ? 'ISEPower: os desafios, a equipa e o diário de desenvolvimento do MEIA no ISEP.' : 'ISEPower: master’s challenges, the team and our development journal at ISEP.'}>
  <HomeLoader slot="loader" locale={locale} />
  <HomeMotion>
    <section class="home-hero"><div class="container">
      <div class="hero-grid">
        <div>
          <p class="eyebrow">{pt ? 'ISEP · Desafio ativo / Desafio 1 · 2026' : 'ISEP · Active challenge / Challenge 1 · 2026'}</p>
          <h1>Demand Response Advisor for <span>Smart Grids</span></h1>
          <p class="lead">{pt ? 'Um sistema de aconselhamento inteligente concebido para apoiar decisões de resposta da procura em redes elétricas inteligentes.' : 'An intelligent advisory system designed to support demand response decisions in smart grids.'}</p>
          <div class="actions">
            <a class="button" href={path('challenges/#challenge-1')}>{pt ? 'Explorar o Desafio 1' : 'Explore Challenge 1'} ↗</a>
            <a class="button secondary" href={path('blog/')}>{pt ? 'Acompanhar o Progresso' : 'View Our Progress'} →</a>
          </div>
        </div>
        <GridConcept locale={locale} />
      </div>
      <div class="hero-note">
        <span>{pt ? 'Mestrado em Inteligência Artificial' : "Master's Degree in Artificial Intelligence"}</span>
        <span><strong>Equipa 10</strong> / MEIA · ISEP</span>
        <span>{status.week}: {pt ? 'aquisição de conhecimento em curso' : 'knowledge acquisition in progress'}</span>
      </div>
    </div></section>
    <WeekOverview locale={locale} />
    <section class="section soft"><div class="container"><div class="section-heading-row"><div class="section-title"><p class="eyebrow">ISEPower / {pt ? 'Diário' : 'Journal'}</p><h2>{pt ? 'Últimas publicações' : 'Latest posts'}</h2></div><a class="text-link" href={path('blog/')}>{pt ? 'Todas as publicações' : 'All posts'} →</a></div><div class="post-list">{posts.map(post => <PostCard post={post} />)}</div></div></section>
  </HomeMotion>
</SiteLayout>
