---
import HeaderLink from './HeaderLink.astro';
import { Image } from 'astro:assets';
import logo from '../../public/logos/ISEPOWERLOGO-rectangle.png';
import { REPOSITORY_URL, PROJECT_TITLE } from '../consts';
import { localizedPath } from '../utils/i18n';
import LanguageSwitcher from './LanguageSwitcher.astro';
import type { LanguageLink } from '../utils/i18n';
import type { BlogLocale } from '../utils/blog';
interface Props { locale?: BlogLocale; alternates: LanguageLink[]; }
const { locale = 'en', alternates } = Astro.props;
const sitePath = (path = '') => localizedPath(locale, path);
const links = locale === 'pt'
  ? [['', 'Início'], ['project/', 'Projeto'], ['blog/', 'Blog'], ['team/', 'Equipa']]
  : [['', 'Home'], ['project/', 'Project'], ['blog/', 'Blog'], ['team/', 'Team']];
---
<header class="site-header">

<div class="container header-inner">
<a class="brand" href={sitePath()} aria-label={locale === 'pt' ? 'Página inicial do ISEPower' : 'ISEPower home'}><Image class="brand-logo" src={logo} alt="ISEPower" width={460} format="webp" loading="eager" /></a>
<nav class="desktop-nav" aria-label={locale === 'pt' ? 'Navegação principal' : 'Main navigation'}>{links.map(([path, title]) => <HeaderLink href={sitePath(path)}>{title}</HeaderLink>)}</nav>
<div class="header-tools">
<a class="github-icon" href={REPOSITORY_URL} aria-label={locale === 'pt' ? 'Repositório do projeto no GitHub' : 'Project repository on GitHub'}><svg viewBox="0 0 24 24" width="23" height="23" fill="currentColor" aria-hidden="true"><path d="M12 .8a11.2 11.2 0 0 0-3.54 21.83c.56.1.77-.24.77-.54v-2.09c-3.13.68-3.79-1.33-3.79-1.33-.51-1.3-1.25-1.64-1.25-1.64-1.02-.7.08-.68.08-.68 1.13.08 1.72 1.16 1.72 1.16 1 .1 1.71 1.7 3.29.77.1-.72.39-1.21.71-1.49-2.5-.28-5.13-1.25-5.13-5.55 0-1.23.44-2.23 1.16-3.02-.12-.28-.5-1.43.11-2.98 0 0 .95-.3 3.08 1.15A10.7 10.7 0 0 1 12 6.01c.95 0 1.9.13 2.79.38 2.14-1.45 3.08-1.15 3.08-1.15.62 1.55.23 2.7.12 2.98.72.79 1.15 1.79 1.15 3.02 0 4.31-2.63 5.26-5.14 5.54.4.35.76 1.03.76 2.08v3.23c0 .3.21.65.78.54A11.2 11.2 0 0 0 12 .8Z"/></svg></a>
<LanguageSwitcher locale={locale} links={alternates} />
</div>
<details class="mobile-menu"><summary>Menu <span aria-hidden="true">☰</span></summary><nav aria-label={locale === 'pt' ? 'Navegação móvel' : 'Mobile navigation'}>{links.map(([path, title]) => <HeaderLink href={sitePath(path)}>{title}</HeaderLink>)}</nav></details>
</div>
<div class="project-banner"><div class="container"><span>{locale === 'pt' ? 'Projeto' : 'Project'}</span><a href={sitePath('project/')}>{PROJECT_TITLE}</a></div></div>
</header>
<style>
  .brand-logo { display: block; width: 230px; height: auto; }
  @media (max-width: 560px) { .brand-logo { width: 170px; } }
  .header-tools { display: flex; flex-direction: column; align-items: center; flex-shrink: 0; gap: 0; padding-left: 1rem; border-left: 1px solid var(--line); }
  .header-tools .github-icon { border: 0; padding: 0; margin: 0; min-height: 36px; }
  @media (max-width: 850px) { .header-tools { margin-left: auto; padding-left: 0; border: 0; } }
  .header-inner { position: relative; }
  .mobile-menu nav { top: 100%; }
  .project-banner { background: var(--surface); border-top: 1px solid var(--line); }
  .project-banner .container { display: flex; align-items: baseline; flex-wrap: wrap; gap: .4rem 1rem; padding-block: .7rem; }
  .project-banner span { color: var(--muted); font-size: .7rem; text-transform: uppercase; letter-spacing: .1em; }
  .project-banner a { color: var(--navy); font-size: .9rem; font-weight: 700; text-decoration: none; }
  .project-banner a:hover { text-decoration: underline; }
</style>
