---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import SiteLayout from './SiteLayout.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { blogText, blogIndexPath, categoryLabel, type LanguageLink } from '../utils/blog';
type Props = CollectionEntry<'blog'>['data'] & { alternates: LanguageLink[] };
const { title, description, pubDate, updatedDate, heroImage, category, lang, alternates } = Astro.props;
const text = blogText[lang];
---
<SiteLayout title={title} description={description} type="article" locale={lang} alternates={alternates}>
  <article class="container section article">
    <a class="text-link" href={blogIndexPath(lang)}>← {text.back}</a>
    <header class="article-header">
      <h1>{title}</h1><p class="lead">{description}</p>
      <div class="post-meta">
        <span class="badge">{categoryLabel(category, lang)}</span>
        <FormattedDate date={pubDate} locale={lang} /><span>Equipa 10</span>
        {updatedDate && <span>{text.updated} <FormattedDate date={updatedDate} locale={lang} /></span>}
      </div>
    </header>
    {heroImage && <Image src={heroImage} width={780} alt="" />}
    <div class="prose"><slot /></div>
  </article>
</SiteLayout>
