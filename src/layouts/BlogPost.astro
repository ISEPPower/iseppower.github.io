---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import SiteLayout from './SiteLayout.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { blogText, blogIndexPath, categoryLabel, type LanguageLink } from '../utils/blog';
import { PROJECT_TITLE } from '../consts';
type Props = CollectionEntry<'blog'>['data'] & { alternates: LanguageLink[] };
const { title, description, pubDate, updatedDate, heroImage, category, lang, alternates, week, reportStatus, authors, contributions } = Astro.props;
const text = blogText[lang];
---
<SiteLayout title={title} description={description} type="article" locale={lang} alternates={alternates}>
  <article class="container section article">
    <a class="text-link" href={blogIndexPath(lang)}>← {text.back}</a>
    <header class="article-header">
      <h1>{title}</h1><p class="lead">{description}</p>
      <div class="post-meta">
        {Astro.props.challenge && <span>{lang === 'pt' ? 'Desafio' : 'Challenge'} {Astro.props.challenge}{Astro.props.challenge === 1 && <>: {PROJECT_TITLE}</>}</span>}
        <span class="badge">{categoryLabel(category, lang)}</span>
        <FormattedDate date={pubDate} locale={lang} /><span>{lang === 'pt' ? 'Autoria' : 'By'}: {authors.join(', ')}</span>
        {week && <span>{lang === 'pt' ? 'Semana' : 'Week'} {week}</span>}
        {reportStatus && <span>{lang === 'pt' ? 'Relatório' : 'Report'}: {reportStatus === 'in-progress' ? (lang === 'pt' ? 'em curso' : 'in progress') : (lang === 'pt' ? 'concluído' : 'complete')}</span>}
        {updatedDate && <span>{text.updated} <FormattedDate date={updatedDate} locale={lang} /></span>}
      </div>
    </header>
    {heroImage && <Image src={heroImage} width={780} alt="" />}
    <div class="prose"><slot /></div>
    <section class="callout" aria-labelledby="contributions-heading">
      <h2 id="contributions-heading">{lang === 'pt' ? 'Contributos da equipa' : 'Team contributions'}</h2>
      {contributions.length ? <ul>{contributions.map(item => <li><strong>{item.name}</strong>: {item.task}</li>)}</ul> : <p>{lang === 'pt' ? 'Os contributos individuais desta semana ainda não estão registados.' : 'Individual contributions for this week have not yet been recorded.'}</p>}
    </section>
  </article>
</SiteLayout>
