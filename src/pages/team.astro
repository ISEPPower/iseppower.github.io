---
import SiteLayout from '../layouts/SiteLayout.astro';
import Hero from '../components/Hero.astro';
import TeamMemberCard from '../components/TeamMemberCard.astro';
import { team } from '../data/team';
import { currentChallenge } from '../data/project';
const current = team.filter(member => member.challenges.includes(currentChallenge));
const former = team.filter(member => !member.challenges.includes(currentChallenge));
import { GITHUB_URL } from '../consts';
---
<SiteLayout title="Team" description="Equipa 10, the MEIA student group behind the Demand Response Advisor project at ISEP."><Hero eyebrow="The Team / MEIA · ISEP" title="Equipa 10" description="A group project for the Master's Degree in Artificial Intelligence at ISEP." /><section class="container section"><div class="section-title"><h2>The people behind the project</h2><p>Meet the members of Equipa 10 working on Challenge {currentChallenge} and learn about their backgrounds and interests.</p></div><div class="grid-2">{current.map(member => <TeamMemberCard member={member} />)}</div>{former.length > 0 && <><div class="section-title former-title"><h2>Former members</h2><p>They took part in earlier challenges and remain part of the team’s history.</p></div><div class="grid-2">{former.map(member => <TeamMemberCard member={member} />)}</div></>}<div class="callout"><h3>Follow our work</h3><p>Our GitHub organisation brings together the website and the code of each challenge.</p><a class="text-link" href={GITHUB_URL}>Visit ISEPower on GitHub ↗</a></div></section></SiteLayout>

<style>
  .former-title { margin-top: 4rem; }
</style>
